\nlet arr=[];\nif(json && json.data){\n  for(let ch of json.data){\n    // manga id from chapter relationships\n    let mangaId='';\n    try{for(let r of ch.relationships){if(r.type=='manga'){mangaId=r.id;break;}}}catch(e){}\n    if(!mangaId || seen[mangaId]) continue;\n    seen[mangaId]=true;\n    let mangaObj=maps.mangaById[mangaId];\n    let title=cleanText(pickLang(mangaObj && mangaObj.attributes ? mangaObj.attributes.title : null)) || 'Unknown';\n    let desc='';\n    try{desc='Ch. '+(ch.attributes.chapter||'?');}catch(e){}\n    let coverFile=getCoverFileForManga(mangaObj, maps);\n    let img='https://i.postimg.cc/4d38NsqH/Manga-Dex-logo.png';\n    if(coverFile) img='https://uploads.mangadex.org/covers/'+mangaId+'/'+coverFile;\n    let imageReq=new ModuleRequest(img,'get',emptyKeyValue,null);\n    let link=new ModuleRequest('https://api.mangadex.org/manga/'+mangaId+'?includes[]=cover_art','get',emptyKeyValue,null);\n    arr.push(new Data(imageReq,title,desc,'','','','',false,link,false));\n    if(arr.length>=10) break;\n  }\n}\nlet output=[];\noutput.push(new Output(CellDesings.wide11,Orientation.horizontal,DefaultLayouts.wideFull,Paging.leading,new Section('Latest Updates',true),null,arr));\nlet nextUrl='https://api.mangadex.org/manga?limit=10&availableTranslatedLanguage[]=en&includes[]=cover_art&order[followedCount]=desc&contentRating[]=safe&contentRating[]=suggestive&contentRating[]=erotica&contentRating[]=pornographic';\nlet MainPageObject=new MainPage(new ModuleRequest(nextUrl,'get',emptyKeyValue,null),new Extra([new Commands('',emptyKeyValue)],emptyKeyValue),new JavascriptConfig(true,false,''),output);\nsavedData.innerHTML=JSON.stringify(MainPageObject);\n"
